{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "title": "Adapter manifest",
  "description": "adapters/<id>/manifest.yaml (spec section 8.2, blueprint section 3.4, change C5). An operation declares inputs and outputs; a conversion declares edges in the conversion graph. Checked by `pnpm registry`, which also enforces the cross-file rules this schema can't express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "workerClass", "limits", "params", "platforms", "requires"],
  "properties": {
    "id": {
      "description": "Must equal the adapter's folder name, and be unique.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "kind": { "enum": ["operation", "conversion"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "devOnly": {
      "description": "Development and test adapters. Left out of the registry unless the generator runs with --include-dev, so they never ship.",
      "type": "boolean",
      "default": false
    },
    "workerClass": {
      "description": "Scheduler pool (blueprint section 5.1).",
      "enum": ["pdf", "image", "render", "office", "ocr", "media"]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "min", "max"],
      "properties": {
        "formats": { "$ref": "#/definitions/formatList" },
        "min": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "max": { "type": "integer", "minimum": 1, "maximum": 2000 }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "cardinality"],
      "properties": {
        "format": {
          "description": "A format, \"same\" (each input's own format) or \"chosen\" (the param \"to\"). ADR 0004.",
          "anyOf": [{ "$ref": "#/definitions/format" }, { "enum": ["same", "chosen"] }]
        },
        "cardinality": { "enum": ["one", "many"] }
      }
    },
    "fidelity": { "$ref": "#/definitions/tier" },
    "edges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "tier"],
        "properties": {
          "from": { "$ref": "#/definitions/formatList" },
          "to": { "$ref": "#/definitions/format" },
          "tier": { "$ref": "#/definitions/tier" },
          "cost": {
            "description": "Relative cost units, the last tie-breaker when ranking plans (blueprint section 3.3 rule 4).",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 1
          }
        }
      }
    },
    "fidelityNotes": {
      "description": "Every warning code the adapter may emit. Each must be in the catalog (spec section 13.1).",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
      "default": []
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutBaseS", "timeoutSPerMb", "noProgressS", "diskFactor"],
      "properties": {
        "timeoutBaseS": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "timeoutSPerMb": { "type": "number", "minimum": 0, "maximum": 3600 },
        "noProgressS": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "diskFactor": { "type": "number", "minimum": 0, "maximum": 100 },
        "processes": {
          "description": "Processes the worker runs at once, itself included, not counting engines (spec 9.2). Windows enforces it.",
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1
        }
      }
    },
    "params": {
      "description": "Path to the parameter schema, relative to the manifest. It must stay inside the adapter folder.",
      "type": "string",
      "pattern": "^\\./[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json$"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["windows", "macos", "linux"] }
    },
    "requires": {
      "description": "Engines the adapter needs. Each must be approved in engines/engines.yaml.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
    }
  },
  "oneOf": [
    {
      "properties": { "kind": { "const": "operation" } },
      "required": ["inputs", "outputs", "fidelity"],
      "not": { "required": ["edges"] }
    },
    {
      "properties": { "kind": { "const": "conversion" } },
      "required": ["edges"],
      "allOf": [
        { "not": { "required": ["inputs"] } },
        { "not": { "required": ["outputs"] } },
        { "not": { "required": ["fidelity"] } }
      ]
    }
  ],
  "definitions": {
    "format": { "enum": ["pdf", "docx", "doc", "odt", "rtf", "pptx", "ppt", "odp", "xlsx", "xls", "ods", "csv", "md", "html", "txt", "epub", "json", "yaml", "png", "jpg", "webp", "svg", "heic", "gif", "bmp", "tiff", "avif", "ico", "mp3", "wav", "flac", "ogg", "opus", "m4a", "aac", "aiff", "mp4", "mov", "mkv", "webm", "avi"] },
    "formatList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/format" }
    },
    "tier": {
      "description": "Fidelity tier (blueprint section 3.1): Exact, High, Reconstructed, Lossy.",
      "enum": ["E", "H", "R", "L"]
    }
  }
}
