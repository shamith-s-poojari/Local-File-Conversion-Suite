{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Organize pages",
  "description": "The final page order. Pages left out are deleted; a page may appear more than once.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pages"],
  "properties": {
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "x-ui": "pageOrganizer",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": { "description": "1-based page number in the input", "type": "integer", "minimum": 1, "maximum": 50000 },
          "rotate": { "description": "Clockwise, relative to the page's current rotation", "enum": [0, 90, 180, 270], "default": 0 }
        }
      }
    }
  }
}
