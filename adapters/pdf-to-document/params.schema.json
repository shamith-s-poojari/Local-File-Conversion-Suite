{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PDF to documents",
  "type": "object",
  "additionalProperties": false,
  "required": ["to"],
  "properties": {
    "to": { "title": "Convert to", "enum": ["docx", "xlsx", "md", "html", "txt"] },
    "pages": {
      "title": "Pages",
      "description": "Leave empty for every page. For example: 1-3, 5, 8-",
      "type": "string",
      "maxLength": 10000,
      "x-ui": "pageRanges"
    },
    "fileTitles": {
      "type": "array",
      "maxItems": 1000,
      "items": { "type": "string", "maxLength": 255 },
      "$comment": "Set by the core."
    }
  }
}
