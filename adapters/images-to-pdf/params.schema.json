{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Combine images into one PDF",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "order": {
      "title": "Page order",
      "type": "array",
      "items": { "type": "string", "maxLength": 64 },
      "maxItems": 500,
      "x-ui": "fileOrder",
      "$comment": "File IDs in page order; the core passes inputs in this order."
    },
    "pageSize": {
      "title": "Page size",
      "enum": ["image", "a4", "letter"],
      "default": "image",
      "x-labels": { "image": "Same as each image", "a4": "A4", "letter": "US Letter" }
    },
    "margin": {
      "title": "Margin",
      "enum": ["none", "small", "large"],
      "default": "none",
      "x-labels": { "none": "None", "small": "Small (¼ inch)", "large": "Large (¾ inch)" }
    },
    "fileTitles": {
      "type": "array",
      "maxItems": 500,
      "items": { "type": "string", "maxLength": 255 },
      "$comment": "Set by the core."
    }
  }
}
