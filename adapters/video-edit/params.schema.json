{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rotate, flip or change speed",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rotate": {
      "title": "Rotate",
      "type": "integer",
      "enum": [0, 90, 180, 270],
      "default": 0,
      "x-labels": { "0": "Don't rotate", "90": "90° clockwise", "180": "180°", "270": "90° anticlockwise" }
    },
    "flip": {
      "title": "Flip",
      "enum": ["none", "horizontal", "vertical"],
      "default": "none",
      "x-labels": { "none": "Don't flip", "horizontal": "Mirror left to right", "vertical": "Upside down" }
    },
    "speed": {
      "title": "Speed",
      "description": "The sound speeds up or slows down with the picture, keeping its pitch.",
      "type": "number",
      "enum": [0.25, 0.5, 0.75, 1, 1.25, 1.5, 2, 4],
      "default": 1,
      "x-labels": { "0.25": "Quarter speed", "0.5": "Half speed", "0.75": "0.75×", "1": "Normal", "1.25": "1.25×", "1.5": "1.5×", "2": "Double speed", "4": "4×" }
    },
    "removeAudio": {
      "title": "Remove the sound",
      "type": "boolean",
      "default": false
    },
    "fileTitles": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "maxLength": 255 },
      "$comment": "Set by the core."
    }
  }
}
