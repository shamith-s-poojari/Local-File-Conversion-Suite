{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Remove hidden details",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "removeCoverArt": {
      "title": "Remove cover art",
      "description": "Drops the picture embedded in a song or video file.",
      "type": "boolean",
      "default": false
    },
    "fileTitles": {
      "type": "array",
      "maxItems": 500,
      "items": { "type": "string", "maxLength": 255 },
      "$comment": "Set by the core."
    }
  }
}
