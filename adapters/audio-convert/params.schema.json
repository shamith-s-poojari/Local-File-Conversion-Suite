{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Convert audio",
  "type": "object",
  "additionalProperties": false,
  "required": ["to"],
  "properties": {
    "to": { "title": "Convert to", "enum": ["mp3", "wav", "flac", "ogg", "opus", "m4a", "aac", "aiff"] },
    "bitrate": {
      "title": "Quality",
      "type": "integer",
      "enum": [96, 128, 160, 192, 256, 320],
      "default": 192,
      "x-labels": {
        "96": "96 kbps (speech, smallest)",
        "128": "128 kbps (good)",
        "160": "160 kbps",
        "192": "192 kbps (very good)",
        "256": "256 kbps (excellent)",
        "320": "320 kbps (highest)"
      },
      "x-when": { "to": ["mp3", "ogg", "opus", "m4a", "aac"] }
    },
    "sampleRate": {
      "title": "Sample rate",
      "type": "integer",
      "enum": [0, 48000, 44100, 22050, 16000],
      "default": 0,
      "x-labels": { "0": "Same as the original", "48000": "48 kHz", "44100": "44.1 kHz (CD)", "22050": "22.05 kHz", "16000": "16 kHz (speech)" }
    },
    "channels": {
      "title": "Channels",
      "type": "integer",
      "enum": [0, 2, 1],
      "default": 0,
      "x-labels": { "0": "Same as the original", "2": "Stereo", "1": "Mono" }
    },
    "start": {
      "title": "Start at",
      "description": "Optional. Minutes and seconds, for example 1:30.",
      "type": "string",
      "maxLength": 12,
      "pattern": "^$|^[0-9]{1,3}(:[0-5]?[0-9]){0,2}(\\.[0-9]{1,3})?$"
    },
    "end": {
      "title": "End at",
      "description": "Optional. Leave empty to keep everything after the start.",
      "type": "string",
      "maxLength": 12,
      "pattern": "^$|^[0-9]{1,3}(:[0-5]?[0-9]){0,2}(\\.[0-9]{1,3})?$"
    },
    "fileTitles": {
      "type": "array",
      "maxItems": 1000,
      "items": { "type": "string", "maxLength": 255 },
      "$comment": "Set by the core."
    }
  }
}
