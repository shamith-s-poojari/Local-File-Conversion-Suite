{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Spec section 11.4: no fs, shell, http, dialog or updater permissions for the renderer. Only the app's own commands, each by name. Native dialogs are opened from Rust. Navigation and new windows are blocked in src/navigation.rs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-pick-files",
    "allow-pick-folder",
    "allow-add-pasted",
    "allow-remove-file",
    "allow-resolve-file",
    "allow-submit-password",
    "allow-inspect-file",
    "allow-find-duplicates",
    "allow-get-targets",
    "allow-get-registry",
    "allow-create-job",
    "allow-create-conversion",
    "allow-create-conversion-skipping",
    "allow-cancel-job",
    "allow-request-preview",
    "allow-get-page-text",
    "allow-save-outputs",
    "allow-confirm-save",
    "allow-can-keep-layout",
    "allow-copy-output",
    "allow-discard-job",
    "allow-get-snapshot",
    "allow-get-diagnostics"
  ]
}
